# env.nu
#
# Installed by:
# version = "0.113.1"
#
# Previously, environment variables were typically configured in `env.nu`.
# In general, most configuration can and should be performed in `config.nu`
# or one of the autoload directories.
#
# This file is generated for backwards compatibility for now.
# It is loaded before config.nu and login.nu
#
# See https://www.nushell.sh/book/configuration.html
#
# Also see `help config env` for more options.
#
# You can remove these comments if you want or leave
# them for future reference.

# ============================================================
# TTN – ny mac 2026. Lagt til manuelt (nushell leser ikke .zprofile/.zshrc).
# Kopi i repoet: ~/gitHub/ttnesby/nushell-config/env.nu.bck
# ============================================================

# ── PATH ──────────────────────────────────────────────────────
# Rekkefølge bevart fra .zshrc: .local/bin → ghcup → cabal → homebrew først,
# deretter systemstiene, Toolbox og verktøy som ikke lenkes inn av Homebrew bakerst.
$env.PATH = (
    $env.PATH
    | prepend [
        ($env.HOME | path join '.local' 'bin')
        ($env.HOME | path join '.ghcup' 'bin')
        ($env.HOME | path join '.cabal' 'bin')
        '/opt/homebrew/bin'
        '/opt/homebrew/sbin'
        ($env.HOME | path join '.cargo' 'bin')
    ]
    | append (open /etc/paths | lines)
    | append (ls /etc/paths.d | get name | each { open $in | lines } | flatten)
    | append ($env.HOME | path join 'Library' 'Application Support' 'JetBrains' 'Toolbox' 'scripts')
    # gcloud-komponenter (gke-gcloud-auth-plugin) – casken lenker bare gcloud til /opt/homebrew/bin
    | append '/opt/homebrew/share/google-cloud-sdk/bin'
    # libpq er keg-only: pg_dump, psql, pg_isready
    | append '/opt/homebrew/opt/libpq/bin'
    | uniq
)

# ── Homebrew (Apple Silicon) ──────────────────────────────────
# Tilsvarer `eval "$(/opt/homebrew/bin/brew shellenv)"`
$env.HOMEBREW_PREFIX = '/opt/homebrew'
$env.HOMEBREW_CELLAR = '/opt/homebrew/Cellar'
$env.HOMEBREW_REPOSITORY = '/opt/homebrew'

# ── 1Password SSH-agent (privatnøkler i valvet, ikke på disk) ──
$env.SSH_AUTH_SOCK = (
    $env.HOME | path join 'Library' 'Group Containers' '2BUA8C4S2C.com.1password' 't' 'agent.sock'
)

# ── Standard editor ───────────────────────────────────────────
$env.EDITOR = 'nvim'

# ── Modul-søkesti: egne nushell-config-moduler (use err, use cidr ...) ──
$env.NU_LIB_DIRS = (
    $env.NU_LIB_DIRS? | default [] | append ($env.HOME | path join 'gitHub' 'ttnesby' 'nushell-config') | uniq
)

# ── mise ──────────────────────────────────────────────────────
# `mise activate nu` tar et øyeblikksbilde av PATH, og vendor/autoload lastes etter denne fila.
# Generer derfor hooken på nytt ved hver oppstart, ellers overskrives PATH-blokken over.
let mise_autoload = ($nu.data-dir | path join 'vendor' 'autoload')
mkdir $mise_autoload
^/opt/homebrew/bin/mise activate nu | save --force ($mise_autoload | path join 'mise.nu')
